        <!-- cozybooks-widget:components:begin -->
        <!-- Home-screen shelf widget. Injected into the generated manifest by
             apply-widget.sh after every `bubblewrap update`. -->
        <receiver
            android:name="app.cozybooks.pinya.widget.BookshelfWidgetProvider"
            android:exported="false"
            android:label="@string/widgetName">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bookshelf_widget_info" />
        </receiver>

        <activity
            android:name="app.cozybooks.pinya.widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name="app.cozybooks.pinya.widget.WidgetGridService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <activity
            android:name="app.cozybooks.pinya.widget.WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name="app.cozybooks.pinya.widget.WidgetTokenActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="widget-setup"
                    android:scheme="cozybooks" />
            </intent-filter>
        </activity>
        <!-- cozybooks-widget:components:end -->
