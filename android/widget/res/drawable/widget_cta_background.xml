<?xml version="1.0" encoding="utf-8"?>
<!-- The app's primary button: a pill with the brand gradient (bg-linear-45 from-brand
     to-brand-warm rounded-full). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="45"
        android:endColor="@color/widget_cta_end"
        android:startColor="@color/widget_cta_start"
        android:type="linear" />
    <corners android:radius="999dp" />
</shape>
