<?xml version="1.0" encoding="utf-8"?>
<!-- The app's light theme. values-night holds the dark one, so the widget follows the
     phone's mode; it can't see the theme picked inside the app. Prefixed so nothing
     Bubblewrap generates can collide. -->
<resources>
    <!-- neutral-50 page, neutral-500/25 border -->
    <color name="widget_background">#FFFAFAFA</color>
    <color name="widget_border">#40737373</color>
    <!-- neutral-950 at the app's 90% for titles and 80% for body text -->
    <color name="widget_title">#E60A0A0A</color>
    <color name="widget_text">#CC0A0A0A</color>
    <!-- The primary button: brand to brand-warm at 45 degrees -->
    <color name="widget_cta_start">#FF9E4CE0</color>
    <color name="widget_cta_end">#FFDB7048</color>
</resources>
