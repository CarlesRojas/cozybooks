# Node 20 silently drops all but the last `Set-Cookie` header of a response on this
# stack, which loses better-auth's session cookie on the Google callback and turns
# signing in into a redirect back to the signed-out page with nothing logged. So the
# Node version is a correctness requirement here, not a preference — see the README.

# Refuse to install on a Node that does not satisfy `engines`, rather than warning.
engine-strict=true

# And pin the one every script runs on, whatever the shell happens to have. pnpm
# downloads it once and uses it for `pnpm dev`, `pnpm build` and the rest.
use-node-version=24.19.0
